# .editorconfig
#
# Editors other than Neovim (and GitHub's web editor) should follow the same
# rules this config uses, so a contribution does not arrive as a 400-line diff.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{lua,md,toml,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab
